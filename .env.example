# 复制这个文件为 .env，然后填入自己的配置（.env 不会被提交到 Git）
# 也可以直接运行 streamlit run app.py，在首次使用的界面里填写，会自动生成 .env

# ---------------- 邮箱设置 ----------------
EMAIL_ACCOUNT=your_email@example.com
# 邮箱授权码（不是登录密码，需要在邮箱设置中开启 IMAP 服务后获取）
EMAIL_PASSWORD=
IMAP_SERVER=mail.buaa.edu.cn
IMAP_PORT=993

# ---------------- 大模型设置（OpenAI 兼容接口） ----------------
# 例如 https://api.deepseek.com 或 https://api.openai.com/v1
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=deepseek-chat
